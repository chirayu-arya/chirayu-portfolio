# Copy to .env.local and fill in. The store runs in "preview mode" (browsable,
# checkout returns 503) until STRIPE_SECRET_KEY + DATABASE_URL are set.

# --- Store: Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Store: Neon Postgres (run lib/store/schema.sql once) ---
DATABASE_URL=

# --- Store: Resend (delivery email) ---
RESEND_API_KEY=
# Optional override of the From address (must be a verified Resend domain)
RESEND_FROM=Chirayu Arya <store@chirayuarya.com>

# Used to build absolute download URLs in the confirmation email.
NEXT_PUBLIC_SITE_URL=https://chirayuarya.com

# --- Existing site integrations (not store-related) ---
PSN_NPSSO=
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=
